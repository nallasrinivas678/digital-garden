# Copy this file to .env.local and fill in your Supabase values
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# llm-gateway (LlmGateway.Assistant) base URL - the daily summary + Google-connect endpoints
VITE_ASSISTANT_API_URL=https://llm-gateway-prnhia.fly.dev

# Optional: serve the Daily Summary from the Node service (services/assistant-node in llm-gateway)
# instead. Leave it out to keep using llm-gateway above. Local Node service: http://localhost:8080
# VITE_DAILY_SUMMARY_API_URL=http://localhost:8080

# Chat (the /app/chat page) calls VITE_ASSISTANT_API_URL above (llm-gateway). Set this to use the Node
# service instead: it has web search and task tools and the same request and answer. Local: http://localhost:8080
# VITE_CHAT_API_URL=http://localhost:8080

# Resume match (the /app/resume-match page) calls the Node service. It uses VITE_DAILY_SUMMARY_API_URL
# above when this is not set. Local Node service: http://localhost:8080
# VITE_RESUME_MATCH_API_URL=http://localhost:8080

# Optional: run the Connect Google flow on the Node service too. Google then returns to
# <this app>/app/google/callback, which must be listed in the Google Cloud console, and the
# service needs GOOGLE_REDIRECT_URI set to that same address. Leave it out to keep llm-gateway.
# VITE_GOOGLE_CONNECT_API_URL=http://localhost:8080
