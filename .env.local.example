# Copy this file to .env.local and fill in your Supabase values
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# llm-gateway (LlmGateway.Assistant) base URL - the daily summary + Google-connect endpoints
VITE_ASSISTANT_API_URL=https://llm-gateway-prnhia.fly.dev

# Optional: serve the Daily Summary from the Node service (services/assistant-node in llm-gateway)
# instead. Leave it out to keep using llm-gateway above. Local Node service: http://localhost:8080
# VITE_DAILY_SUMMARY_API_URL=http://localhost:8080
